# Copy to .env. Never commit real credentials.
DB_PASSWORD=
BOOTSTRAP_USERNAME=hq@your-company.example
# At least 12 characters, at most 72 UTF-8 bytes. Used only for an empty database.
BOOTSTRAP_PASSWORD=
APP_PUBLIC_URL=http://localhost:8080
# false only for local HTTP. Set true when serving over HTTPS.
COOKIE_SECURE=false
ECPAY_ENABLED=false
ECPAY_ENVIRONMENT=stage
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
